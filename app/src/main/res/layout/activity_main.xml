<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"

    android:fitsSystemWindows="true">


    <EditText
        android:id="@+id/etText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_string"
        android:inputType="text"
        android:layout_margin="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/tvErrorView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:visibility="gone"
        android:layout_margin="@dimen/screen_margin"
        app:layout_constraintTop_toBottomOf="@id/etText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/tvOutputView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/output"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_margin="@dimen/screen_margin"
        app:layout_constraintTop_toBottomOf="@id/tvErrorView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/btnLength"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/length"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="@dimen/screen_margin"
        app:layout_constraintTop_toBottomOf="@id/tvOutputView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnReverse"/>

    <Button
        android:id="@+id/btnReverse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/reverse"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="@id/btnLength"
        app:layout_constraintStart_toEndOf="@id/btnLength"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/btnAppend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/append"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="@dimen/screen_margin"
        app:layout_constraintTop_toBottomOf="@id/btnLength"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnIsNumeric"/>

    <Button
        android:id="@+id/btnIsNumeric"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/is_numeric"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="@id/btnAppend"
        app:layout_constraintStart_toEndOf="@id/btnAppend"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Clear Button -->
    <Button
        android:id="@+id/btnClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clear"
        app:layout_constraintTop_toBottomOf="@id/btnAppend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
